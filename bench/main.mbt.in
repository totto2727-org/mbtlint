///|
fn builtin_rules() -> Array[@core.Rule] {
  [
    @rule.no_todo(),
    @rule.no_duplicate_test_name(),
    @rule.prefer_label_pun(),
    @rule.prefer_field_pun(),
    @rule.no_mut(),
    @rule.require_public_docs(),
    @rule.prefer_labelled_parameters(),
    @rule.prefer_arrow_callback(),
    @rule.no_manual_path_join(),
    @rule.require_named_tests(),
    @rule.no_redundant_rethrow(),
    @rule.prefer_collection_map(),
    @rule.prefer_collection_filter(),
    @rule.prefer_collection_transfer(),
    @rule.prefer_collection_any(),
    @rule.prefer_collection_all(),
    @rule.prefer_collection_find(),
    @rule.prefer_collection_fold(),
    @rule.no_panic(),
    @rule.no_unsafe_unwrap(),
    @rule.no_try_bang(),
    @rule.no_unsafe_operations(),
    @rule.simplify_bool_if(),
    @rule.simplify_bool_match(),
    @rule.redundant_bool_pattern(),
    @rule.constant_condition(),
    @rule.redundant_bool_operand(),
    @rule.no_self_assignment(),
    @rule.catch_hides_failure(),
    @rule.safe_name_is_safe(),
    @rule.pure_name_is_pure(),
  ]
}

///|
fn all_rules() -> @core.Config {
  builtin_rules().fold(init=@core.Config(), (config, rule) => {
    config.with_rule(rule, severity=Warning)
  })
}

///|
fn benchmark_config(cohort : String) -> @core.Config raise {
  let base = @core.Config()
  match cohort {
    "parse-only" => base
    "decl-only" =>
      base
      .with_rule(@rule.no_duplicate_test_name())
      .with_rule(@rule.require_public_docs())
      .with_rule(@rule.prefer_labelled_parameters())
      .with_rule(@rule.require_named_tests())
    "recommended" => @preset.recommended()
    "collections" => @preset.with_collections(base)
    "all" => all_rules()
    _ => {
      for rule in builtin_rules() {
        if rule.id == cohort {
          return base.with_rule(rule)
        }
      }
      fail("Unknown benchmark cohort: \{cohort}")
    }
  }
}

///|
fn emit_finding(d : @core.Diagnostic) -> Unit {
  let end = d.loc.end
  println("\{d} (ends at \{end.lnum}:\{end.column()})")
  if d.fix is Some(edit) {
    println("  edit \{edit.start}:\{edit.end} \{edit.replacement.escape()}")
  }
}

///|
fn run_core(
  cohort : String,
  rounds : Int32,
  paths : ArrayView[String],
) -> Unit raise {
  let config = benchmark_config(cohort)
  guard rounds > 0 && !paths.is_empty() else {
    fail("Expected a positive repeat count and at least one source path")
  }
  let inputs = paths.map(path => (path, @fs.read_file_to_string(path)))
  let mut total = 0
  for round in 0..<rounds {
    for input in inputs {
      let (path, source) = input
      let findings = config.lint(path~, source~)
      total += findings.length()
      for finding in findings {
        if finding.rule_id is None {
          fail("Unparseable benchmark input: \{finding}")
        }
        if round == 0 {
          emit_finding(finding)
        }
      }
    }
  }
  if cohort != "parse-only" && total == 0 {
    fail("No findings for benchmark cohort \{cohort}")
  }
  println("\{paths.length() * rounds} file passes, \{total} findings")
}

///|
async fn main {
  let args = @env.args()
  try {
    match args[:] {
      [_, "list"] =>
        for rule in builtin_rules() {
          println(rule.id)
        }
      [_, "core", cohort, rounds, .. paths] =>
        run_core(cohort, @string.parse_int(rounds[:], radix=10), paths)
      [_, "tool", .. options] => {
        let app = @core.engine(all_rules(), emit=emit_finding)
        app.run(argv=Some(options.to_owned()))
      }
      _ =>
        fail(
          "Expected list, core COHORT ROUNDS FILES..., or tool FLAGS FILES...",
        )
    }
  } catch {
    error => {
      @debug.debug(error)
      @sys.exit(1)
    }
  }
}
